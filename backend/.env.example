AI_DAILY_FREE_LIMIT=8
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://localhost,capacitor://localhost

# Optional: Claude-assisted draft generation (server-side only)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Parent account database: use a persistent, private volume in production.
PARENT_AUTH_DB=./backend/data/parents.sqlite3

# Required to use PDF review / OCR / evidence / Claude-draft routes (send as X-Admin-Token header).
ADMIN_TOKEN=
# Local development only: open those routes without a token.
# ALLOW_OPEN_REVIEW_API=1
